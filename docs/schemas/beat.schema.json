{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivivieri.github.io/3d-jrpg-game-factory/schemas/beat.schema.json",
  "title": "Beat",
  "type": "object",
  "required": ["id", "chapter", "weight", "systems"],
  "additionalProperties": true,
  "properties": {
    "id": { "$ref": "common.defs.json#/$defs/beatId" },
    "chapter": { "type": "integer", "minimum": 1 },
    "weight": { "type": "number", "exclusiveMinimum": 0 },
    "systems": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "common.defs.json#/$defs/systemId" }
    },
    "scene": { "$ref": "common.defs.json#/$defs/sceneId" },
    "art_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dialogue_refs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locale_keys": {
      "type": "array",
      "items": { "type": "string" }
    },
    "description": { "type": "string" }
  }
}
