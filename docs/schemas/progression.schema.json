{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivivieri.github.io/3d-jrpg-game-factory/schemas/progression.schema.json",
  "title": "Progression and endings",
  "type": "object",
  "required": ["endings"],
  "additionalProperties": false,
  "properties": {
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^END_[A-Z0-9_]+$"
      }
    }
  }
}
