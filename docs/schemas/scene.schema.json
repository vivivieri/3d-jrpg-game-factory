{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vivivieri.github.io/3d-jrpg-game-factory/schemas/scene.schema.json",
  "title": "Scene",
  "type": "object",
  "required": ["id", "pois"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.defs.json#/$defs/sceneId" },
    "pois": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "systems"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^POI_[A-Z0-9_]+$" },
          "systems": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.defs.json#/$defs/systemId" }
          }
        }
      }
    }
  }
}
